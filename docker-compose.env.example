APP_ENV=development
JWT_SECRET_KEY=local-development-only-change-this-secret-before-sharing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
COMPOSE_DATABASE_URL=postgresql://trackflow:trackflow_dev@db:5432/trackflow?sslmode=disable
POSTGRES_DB=trackflow
POSTGRES_USER=trackflow
POSTGRES_PASSWORD=trackflow_dev
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=TrackFlow <onboarding@resend.dev>
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Optional: the Redis the API and the Celery worker share inside Compose.
# Defaults to the `redis` service; REDIS_URL in this file is ignored by Compose.
# COMPOSE_REDIS_URL=redis://redis:6379/0
