# Copy to .env and fill in real values. .env is git-ignored.

# --- Access tokens -----------------------------------------------------------

# Signing secret for JWT access tokens. Minimum 32 characters.
# Also signs password reset tokens, which are the same kind of JWT with a
# `typ: password_reset` claim, so a reset link cannot be replayed as a session.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Signing algorithm. HS256 unless you move to asymmetric keys.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Password recovery -------------------------------------------------------

# How long a password reset link stays valid, in minutes.
# Must be between 15 and 60; anything else fails at startup.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# API key for Resend, the transactional email service that carries the reset
# link. Get one at https://resend.com/api-keys. Leave it unset in development:
# the API then logs the whole message, reset link included, instead of sending
# it, so the flow is walkable without an email account.
# NEVER commit a real key - this file is the example, .env is the real one.
RESEND_API_KEY=

# Sender address for outgoing mail. `onboarding@resend.dev` is Resend's shared
# sender: it needs no DNS setup, but in test mode it only delivers to the email
# address that owns the Resend account. Swap it for an address on a domain you
# have verified with Resend before sending to anyone else.
EMAIL_FROM=TrackFlow <onboarding@resend.dev>

# Base URL of the frontend that handles the reset link. The API appends
# `/reset-password?token=<jwt>` to it when composing the email.
# uis/website runs on 3000, uis/backoffice on 3001.
FRONTEND_BASE_URL=http://localhost:3000

# --- Storage -----------------------------------------------------------------

# Optional: override the TinyDB file location.
# DB_PATH=data/suppliers.json

# Supabase PostgreSQL for inventory, and for creating the telemetry table's
# indexes and append-only guard at startup. Use the transaction pooler string
# from Supabase -> Connect. SSL is required; `?sslmode=disable` is only
# accepted with APP_ENV=development. Quote it if the password has `$` or `#`.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres"

# --- Supabase client (telemetry ingest) ------------------------------------

# Project URL, from Supabase -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret API key (`sb_secret_...`). It bypasses Row Level Security, so it is
# server-only: never put it in a NEXT_PUBLIC_ variable or any frontend code.
# NEVER commit a real key - this file is the example, .env is the real one.
SUPABASE_SECRET_KEY=

# --- Task queue (services/tasks/) --------------------------------------------

# Redis instance used as the Celery broker and result backend. The API enqueues
# heavy work here (POST /telemetry/report) and the worker (`npm run worker`)
# consumes it, so both must point at the same Redis. Defaults to a local Redis
# on 6379, which `docker compose up redis` publishes. Use `rediss://` for TLS.
# REDIS_URL=redis://localhost:6379/0

# --- Business performance pipeline (data/pipelines/) ----------------------

# Prefect server the API schedules manual runs on (POST /reporting/pipeline-runs)
# and that `python data/pipelines/pipeline.py --serve` registers the weekly
# deployment with. Start one with `uv run prefect server start`. Leave unset to
# run the pipeline only from the command line; the trigger endpoint then
# answers 503.
# PREFECT_API_URL=http://127.0.0.1:4200/api

# Optional: point a pipeline run at another database. Without it the pipeline
# uses the Prefect Secret block `trackflow-reporting-database-url`, then
# DATABASE_URL above.
# REPORTING_DATABASE_URL=

# --- Knowledge base / RAG (Milestone 7) ----------------------------------

# Qdrant holding the `trackflow_knowledge` collection. Locally that is
# `docker compose up -d qdrant` (REST on 6333, dashboard at /dashboard).
# For Qdrant Cloud, put the cluster URL here (https://...:6333) and set the key.
QDRANT_URL=http://localhost:6333
# Only for Qdrant Cloud or a secured instance; the local container has none.
# NEVER commit a real key - this file is the example, .env is the real one.
# QDRANT_API_KEY=

# The 4Geeks-provided models, served through an OpenAI-compatible API.
# Two different model IDs: the embeddings model turns text into vectors (index
# time and question time), the generation model writes the answer. They must
# differ; the settings refuse the same ID for both. Use the IDs exactly as the
# gateway's /v1/models lists them for your key (no "litellm/" prefix).
EMBEDDING_MODEL=
GENERATION_MODEL=
# Endpoint and key for both models. NEVER commit a real key. The base URL must
# include the /v1 suffix (the 4Geeks gateway: https://llm.4geeks.ai/v1);
# without it the SDK calls paths the gateway does not answer.
LLM_BASE_URL=
LLM_API_KEY=
# Only if the embeddings model is served from another endpoint or key;
# otherwise LLM_BASE_URL and LLM_API_KEY are used for it too.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# Seconds per model request (2 retries follow). Default 30, for the API. The
# 4Geeks gateway can stall for minutes; raise it for the batch commands:
# LLM_TIMEOUT_SECONDS=120 npm run rag:eval
# LLM_TIMEOUT_SECONDS=30

# Knowledge agent (services/agent, the RAG flow as a LangGraph graph). One
# SQLite file holds LangGraph's checkpoints and the run traces; it is created on
# first use and git-ignored. A relative path is resolved from the repository
# root. Compose sets /app/var/agent_runs.sqlite (the api_data volume).
# AGENT_STORE_PATH=data/agent/agent_runs.sqlite

# The agent's memory (MEM-092, docs/agent/agent-memory.md): conversations, memory
# proposals, the append-only decision log and the approved memories, shared by
# every user of the agent. SQLite, its own file, created on first use and
# git-ignored; never the knowledge base. Compose sets /app/var/agent_memory.sqlite.
# AGENT_MEMORY_PATH=data/agent/agent_memory.sqlite

# The agent's live lookups go through the TrackFlow MCP server (mcps/), never
# straight to the Incidents Manager or the inventory. The agent is an OAuth
# client: an Auth0 machine-to-machine application authorized for the MCP
# server's API with the read scopes only (docs/mcp/mcp-server.md, "Auth0 setup").
# Unset, ticket and stock questions get the honest "could not confirm" answer.
# AGENT_MCP_URL=http://localhost:8100/mcp
# AGENT_OAUTH_TOKEN_URL=https://<tenant>.<region>.auth0.com/oauth/token
# AGENT_OAUTH_CLIENT_ID=
# AGENT_OAUTH_CLIENT_SECRET=
# The Auth0 API identifier of the MCP server (= MCP_AUTH_AUDIENCE).
# AGENT_OAUTH_AUDIENCE=https://mcp.trackflow.dev/mcp
# AGENT_OAUTH_SCOPES=incidents:read inventory:read
# The whole budget of one live lookup through MCP, in seconds (0 < value <= 10).
# AGENT_TOOL_TIMEOUT_SECONDS=5

# --- MCP server (npm run mcp; mcps/trackflow_tools) -------------------------------
# The MCP endpoint's public URL: the protected resource's identifier, and its
# path is where the endpoint is served. In Codespaces, the forwarded URL
# (https://<codespace>-8100.app.github.dev/mcp). Required.
# MCP_RESOURCE_URL=http://localhost:8100/mcp
# The authorization server that issues the access tokens: the Auth0 tenant URL,
# with its trailing slash. Required. Its OIDC metadata is fetched at startup.
# MCP_AUTH_ISSUER=https://<tenant>.<region>.auth0.com/
# MCP_AUTH_SERVER_TYPE=oidc
# The `aud` a token must carry: the Auth0 API identifier (defaults to MCP_RESOURCE_URL).
# MCP_AUTH_AUDIENCE=https://mcp.trackflow.dev/mcp
# MCP_HOST=127.0.0.1
# MCP_PORT=8100
# The services the MCP server exposes, over HTTP (both are routers of this API).
# MCP_INCIDENTS_API_URL=http://localhost:8000
# MCP_INVENTORY_API_URL=http://localhost:8000
# The inventory routes need a TrackFlow login: the MCP server signs in as this
# service account (create it once: uv run seed-user --email
# mcp-inventory@trackflow.com --role user). MCP clients never see it.
# MCP_INVENTORY_EMAIL=mcp-inventory@trackflow.com
# MCP_INVENTORY_PASSWORD=
# MCP_UPSTREAM_TIMEOUT_SECONDS=4
# Browser MCP clients allowed to call the endpoint, comma-separated (the MCP
# Playground's origin). Empty: no CORS.
# MCP_CORS_ORIGINS=
# Extra Host headers to accept besides the resource URL's host and localhost.
# MCP_ALLOWED_HOSTS=
# One JSON line per tool invocation (git-ignored logs/).
# MCP_AUDIT_LOG_PATH=logs/mcp_tool_calls.jsonl
# Only for `npm run mcp:token -- --client tester`: an Auth0 M2M application with
# every scope, to try the write tools from the Playground.
# MCP_TESTER_CLIENT_ID=
# MCP_TESTER_CLIENT_SECRET=
