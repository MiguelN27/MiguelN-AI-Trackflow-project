{
  "name": "migueln-ai-trackflow-project",
  "version": "0.1.0",
  "private": true,
  "description": "Root scripts for running the TrackFlow project",
  "scripts": {
    "start": "python3 services/server.py",
    "api": "uv run uvicorn services.main:app --reload --port 8000",
    "seed:suppliers": "uv run seed",
    "seed:user": "uv run seed-user",
    "seed:incidents": "uv run seed-incidents",
    "seed:inventory": "uv run python -m scripts.seed_inventory",
    "job:nightly-export": "uv run python scripts/nightly_export.py",
    "rag:setup": "uv run python -m data.process.knowledge_base",
    "rag:eval": "uv run python -m scripts.evaluate_rag_retrieval",
    "agent": "uv run python -m services.agent",
    "agent:record": "uv run python -m scripts.record_agent_traces",
    "agent:eval": "uv run pytest tests/pipelines/test_agent_evals.py -v",
    "agent:memory:eval": "uv run pytest tests/pipelines/test_agent_memory_evals.py -v",
    "agent:memory:calibrate": "uv run python -m scripts.calibrate_memory_recall",
    "mcp": "uv run python -m mcps.trackflow_tools serve",
    "mcp:tools": "uv run python -m mcps.trackflow_tools tools",
    "mcp:token": "uv run python -m mcps.trackflow_tools token",
    "worker": "uv run celery -A services.tasks.celery_app:celery_app worker --loglevel=INFO --concurrency=2 -E",
    "test:api": "uv run pytest tests/ -q",
    "install:all": "npm --prefix uis/website install && npm --prefix uis/backoffice install && python3 -m pip install -r requirements.txt",
    "dev:website": "npm --prefix uis/website run dev",
    "dev:backoffice": "npm --prefix uis/backoffice run dev",
    "test:ui": "npm --prefix uis/website test && npm --prefix uis/backoffice test"
  }
}
